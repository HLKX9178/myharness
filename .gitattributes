# 统一换行符规则，避免 git 在 Windows 上反复提示
# "LF will be replaced by CRLF"，并保证跨平台一致。

# 源码统一 LF
* text=auto eol=lf

# Windows 脚本必须 CRLF：cmd.exe 对 LF-only 的括号块解析会出错
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 二进制文件不做换行符转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.xlsx binary
