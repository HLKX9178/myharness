# 复制本文件为 .env，填入真实值。.env 不会被提交。

# ---- 必填 ----

# API Key
ANTHROPIC_API_KEY=your-key-here

# 模型 ID
MODEL_ID=claude-sonnet-4-6

# ---- 可选：使用 Anthropic 兼容的第三方 provider ----
# 不设置则走 Anthropic 官方端点。

# GLM (Zhipu)     https://z.ai
# ANTHROPIC_BASE_URL=https://open.bigmodel.cn/api/anthropic
# MODEL_ID=glm-5.2

# Kimi (Moonshot) https://platform.moonshot.cn
# ANTHROPIC_BASE_URL=https://api.moonshot.cn/anthropic
# MODEL_ID=kimi-k2.7-code

# DeepSeek        https://platform.deepseek.com
# ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
# MODEL_ID=deepseek-v4-pro

# ---- 可选：单次模型回复的 token 上限 ----
# 不设置时默认 8000。
#
# 设置过小会在模型写大文件时截断工具参数，报错形式通常是
#   Error: TypeError: write_file() missing 2 required positional arguments
# 看起来像是模型不会用工具，实际是输出被 max_tokens 截断了。
#
# 各 provider 的上限不同，超过上限会被上游拒绝（报错信息由 provider 给出）。
# 请按所用量档的文档确认后再调高。
# MAX_TOKENS=8000

# ---- 可选：单次请求的输入上限（上下文）----
# 不设置时默认 100000。历史估算超过它的 80% 就会丢掉最早的整轮对话；
# 如果单条 tool_result 自己就超标（例如读了一个几万行的文件），会被截断并留下
# 「[已截断]」标记。
#
# 请按模型的上下文窗口设置，并给它留出回答空间：
#   128k 窗口 -> 100000    64k 窗口 -> 50000    32k 窗口 -> 24000
# 设得过大的后果不是压缩，而是请求被上游以 context length exceeded 拒绝。
# MAX_CONTEXT_TOKENS=100000

# ---- 可选：一轮对话的累计消耗上限 ----
# 不设置时默认 1000000。注意这个值涨得比上下文快得多：每轮请求都会把整段
# 历史重新发一遍，所以它是「每次请求的输入 + 输出」的累加，不是当前上下文大小。
# 一轮十几二十次工具调用的正常任务通常消耗几十万，不要按上下文窗口的直觉设。
#
# 超限时本轮会结束（模型已发出的工具调用补一条「未执行」的结果，保证历史合法），
# 下一轮可以继续问。真要一口气跑完长任务，就调大它或拆成多轮。
# TURN_TOKEN_BUDGET=1000000

# ---- 可选：一轮对话的模型请求次数上限 ----
# 不设置时默认 200。语义是「一次提问内最多问模型多少次」，再问一句就重新计数。
#
# 这一项是**兜底**，不是主要的刹车：真正拦住死循环的是
#   无进展检测（同参数连续 5 次拿到同样的结果）
#   连续失败（连续 3 次工具调用报错）
#   以及上面的 TURN_TOKEN_BUDGET
# 所以它可以设得很大。反过来说，如果观察到任务总是撞到 MAX_TURNS 才停，
# 先看终端里的「无进展」「连续失败」提示 —— 多半是模型拿不到有效反馈，
# 加大 MAX_TURNS 只会让问题晚一点暴露。
# MAX_TURNS=200

# ---- 可选：单次模型请求的超时（秒）----
# 不设置时默认 120 秒。连接超时固定收紧到 10 秒（连不上的情况几秒内就有结论）。
#
# 为什么必须显式设置：两个 SDK 的默认超时都是 600 秒，而 providers 层会最多
# 尝试 3 次 —— 一次卡死的请求就能让进程静默占住近半小时。多 Agent 场景下
# 表现为该 worker 停止轮询、它认领的任务被永久占住。
#
# 调大的场景：模型单次生成很长（例如一次写一个大文件）。此时先确认
# MAX_TOKENS 是否真的需要那么大，再调这个值。
# REQUEST_TIMEOUT_SECONDS=120

# ---- 可选：Agent 的工作目录 ----
# 不设置时默认是仓库根目录（方便 Agent 阅读项目文档，但它也能改自己的源码）。
# 设成别处即可让 Agent 在另一个项目里工作 —— 该目录同时成为权限边界，
# 读写、bash、glob 都被限制在里面（目录必须已存在，否则启动直接报错）。
#
# 注意：load_dotenv 使用 override=True，所以在这里填的 WORKDIR 会盖过
# 命令行的环境变量。如果想每次临时切目录，请不要在这里写 WORKDIR。
# WORKDIR=D:\projects\my-app
